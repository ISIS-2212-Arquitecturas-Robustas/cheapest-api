# Application
NODE_ENV=production

# AWS Cognito - valores del Output del stack CloudFormation (chiper-lab6-jwt)
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_REGION=us-east-1
COGNITO_CLIENT_ID=<CognitoUserPoolClientId>
APP_PORT=3000

# Database Configuration
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=chiper

# For Docker Compose
# Uncomment these when using docker-compose
# DB_HOST=postgres
# DB_USERNAME=postgres
