static_resources:
  listeners:
    - name: ventas_to_inventario
      address:
        socket_address:
          address: 0.0.0.0
          port_value: 10000
      filter_chains:
        - filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: ventas_proxy
                access_log:
                  - name: envoy.access_loggers.stdout
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
                route_config:
                  name: local_route
                  virtual_hosts:
                    - name: inventario
                      domains: ["*"]
                      routes:
                        - match:
                            prefix: "/"
                          route:
                            cluster: inventario_cluster
                            # timeout = connect_timeout × (1 + num_retries) + backoff acumulado
                            #         = 2s × (1 + 1) + ~0.13s (base_interval con jitter) ≈ 4.13s → 5s de margen
                            timeout: 5s
                            retry_policy:
                              retry_on: "5xx,reset,connect-failure,gateway-error"
                              # num_retries=1 → a lo sumo 2 llamadas a Inventario por request (1 original + 1 retry)
                              # = factor de amplificación 2× exacto, cumple el límite de ASR-2 (≤ 2×).
                              num_retries: 1
                              retry_back_off:
                                # base_interval: espera corta para no acumular latencia en fallos transitorios.
                                base_interval: 0.1s
                                # max_interval: acota el backoff para que quepa dentro del timeout de la ruta.
                                max_interval: 1s
                              retry_host_predicate:
                                - name: envoy.retry_host_predicates.previous_hosts
                                  typed_config:
                                    "@type": type.googleapis.com/envoy.extensions.retry.host.previous_hosts.v3.PreviousHostsPredicate
                              host_selection_retry_max_attempts: "3"
                http_filters:
                  - name: envoy.filters.http.router
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router

  clusters:
    - name: inventario_cluster
      connect_timeout: 2s
      type: STRICT_DNS
      lb_policy: ROUND_ROBIN
      load_assignment:
        cluster_name: inventario_cluster
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address:
                      # Sustituido en tiempo de arranque por entrypoint.sh mediante envsubst.
                      # docker-compose → INVENTARIO_UPSTREAM_HOST=inventario, INVENTARIO_UPSTREAM_PORT=3002
                      # ECS (mismo task) → INVENTARIO_UPSTREAM_HOST=localhost, INVENTARIO_UPSTREAM_PORT=3002
                      # ECS (cross-task) → INVENTARIO_UPSTREAM_HOST=<ALB DNS>, INVENTARIO_UPSTREAM_PORT=80
                      address: ${INVENTARIO_UPSTREAM_HOST}
                      port_value: ${INVENTARIO_UPSTREAM_PORT}

      # Límites de recursos del proxy — evitan que el sidecar mismo se convierta en un cuello de botella.
      circuit_breakers:
        thresholds:
          - priority: DEFAULT
            max_connections: 100
            max_pending_requests: 50
            max_requests: 100
            max_retries: 10

      # Outlier detection = implementación del patrón Circuit Breaker en Envoy.
      # Estados: CLOSED (normal) → OPEN (host eyectado) → HALF-OPEN (prueba automática).
      outlier_detection:
        # consecutive_5xx=3: suficientemente sensible para abrir rápido ante un fallo persistente
        # (delay de 5s de Inventario dispara timeout+5xx en cada intento), sin abrir por un único
        # error transitorio aislado.
        consecutive_5xx: 3
        interval: 10s
        # base_ejection_time=20s: bien por debajo de cualquier RECOVERY_TIME_MS usado en el lab
        # (60s por defecto en el template, 600s en la ronda de reproducción del fallo), así el
        # circuito reintenta HALF-OPEN varias veces mientras Inventario sigue caído y detecta
        # la recuperación automática sin esperar el ejection_time completo de una sola vez.
        base_ejection_time: 20s
        max_ejection_percent: 100
        enforcing_consecutive_5xx: 100
        enforcing_success_rate: 0
        split_external_local_origin_errors: false

admin:
  address:
    socket_address:
      address: 0.0.0.0
      port_value: 9901
